#!/usr/bin/env python3
"""nizho: install apps from Flathub, after showing what each one can reach.

    nizho install APP [--yes] [--any]   show what APP can reach, ask, then install it
    nizho remove APP [--data] [--yes]   ask, then remove APP (--data also deletes its saved data)
    nizho update [APP]                  update your apps, or just APP, to the newest version from Flathub
    nizho search [WORDS]                list the apps Nizho suggests
    nizho info APP                      show what APP can reach, change nothing
    nizho list                          list the apps you installed

Apps come from Flathub and install for your account only, so no password is needed
and nothing in the system image changes. The suggested list (/usr/share/nizho/apps.json)
is a selection by Nizho, not an audit: nobody here has reviewed these apps' code.
APP is a name from that list or a Flathub id such as org.videolan.VLC; an id that
isn't on the list needs --any. Exit codes: 0 done, 3 you said no, anything else failed. Flatpak permissions limit what an app can reach;
they don't make an app safe.
"""

import configparser
import json
import os
import subprocess
import sys

CATALOG = os.environ.get("NIZHO_APPS_CATALOG", "/usr/share/nizho/apps.json")
REMOTE = "flathub"
REMOTE_FILE = "/usr/share/nizho/flathub.flatpakrepo"   # shipped in the image, carries Flathub's signing key

# Plain words for what a Flatpak permission lets an app do, after flatpak-metadata(5).
# "wide" ones are listed apart, because they reach well beyond the app itself.
# A permission with no entry here is still shown, by its Flatpak name, as broad access.
SHARED = {
    "network": ("Connect to the internet", False),
    "ipc": ("Share memory with other programs on this computer", False),
}
SOCKETS = {
    "x11": ("Use X11, an older display system that doesn't keep it apart from other X11 apps", True),
    "fallback-x11": ("Use X11, an older display system, when Wayland is missing", False),
    "wayland": ("Show windows on your screen", False),
    "inherit-wayland-socket": ("Pass its screen connection to programs it starts", False),
    "pulseaudio": ("Play sound and use the microphone", False),
    "session-bus": ("Talk to every program and service on the desktop bus, with no filter", True),
    "system-bus": ("Talk to every service on the system bus, with no filter", True),
    "ssh-auth": ("Use your SSH keys", True),
    "pcsc": ("Use smart cards", False),
    "cups": ("Print", False),
    "gpg-agent": ("Use your GPG keys", True),
}
DEVICES = {
    "all": ("Use every device, including cameras and USB devices", True),
    "dri": ("Use the graphics card", False),
    "shm": ("Use the memory folder all programs share (/dev/shm)", False),
    "usb": ("Use USB devices", False),
    "input": ("Read game controllers and input devices", False),
    "kvm": ("Run virtual machines", False),
}
FEATURES = {
    "bluetooth": ("Use Bluetooth", False),
    "devel": ("Use developer features that weaken its sandbox", True),
    "multiarch": ("Run programs built for another kind of processor", False),
    "canbus": ("Use the CAN bus", False),
    "per-app-dev-shm": ("Share one memory folder between its own running copies", False),
}
FILES = {
    "host": "all your files",
    "host-root": "the whole system and every file on it",
    "host-os": "the system's files",
    "host-etc": "the system's settings in /etc",
    "home": "your whole home folder",
    "xdg-download": "your Downloads folder",
    "xdg-documents": "your Documents folder",
    "xdg-pictures": "your Pictures folder",
    "xdg-music": "your Music folder",
    "xdg-videos": "your Videos folder",
    "xdg-desktop": "your Desktop folder",
    "xdg-public-share": "your Public folder",
    "xdg-templates": "your Templates folder",
    "xdg-config": "your settings folder (~/.config)",
    "xdg-data": "the folder where your apps keep their data (~/.local/share)",
    "xdg-cache": "your cache folder (~/.cache)",
}
WIDE_FILES = {"host", "host-root", "host-os", "host-etc", "home", "xdg-config", "xdg-data"}
CONTEXT_LISTS = (("shared", SHARED), ("sockets", SOCKETS), ("devices", DEVICES), ("features", FEATURES))
CONTEXT_NOT_ACCESS = {"unset-environment"}
# Sections of the metadata that grant nothing by themselves.
# "X-" sections are notes for other tools (X-DConf names settings to copy over); Flatpak's sandbox ignores them.
SECTIONS_NOT_ACCESS = ("Application", "Runtime", "Environment", "Extension ", "ExtensionOf", "Extra Data", "Build", "X-")
# A bus name that lets an app start programs outside its sandbox.
HOST_COMMAND_NAME = "org.freedesktop.Flatpak"


def _opts(value):
    return [v for v in value.split(";") if v] if value else []


def _granted(value):
    """The items of a permission list that are granted: (name, only under a condition)."""
    for item in _opts(value):
        if item.startswith("!"):
            continue
        if item.startswith("if:"):
            parts = item.split(":", 2)
            if len(parts) == 3 and parts[2] == "false":
                continue
            yield (parts[1] if len(parts) == 3 else item), True
        else:
            yield item, False


def _unknown(what):
    return f"Something Nizho has no plain words for: {what}"


def _file_sentence(entry):
    """(sentence, wide) for one filesystems= entry."""
    path, mode = entry, "rw"
    for suffix in ("ro", "rw", "create"):
        if entry.endswith(":" + suffix):
            path, mode = entry[: -len(suffix) - 1], suffix
    verb = {"ro": "Read", "create": "Read, change and create"}.get(mode, "Read and change")
    if path == "~":
        path = "home"
    elif path.startswith("home/"):
        path = "~/" + path[len("home/"):]
    if path in FILES:
        return f"{verb} {FILES[path]}", path in WIDE_FILES
    base, _, sub = path.partition("/")
    if base == "xdg-run" and sub:
        return (f"{verb} {sub} in your session folder (/run/user), "
                "where running programs keep the sockets they talk through"), True
    if base in FILES and sub and not base.startswith("host"):
        return f"{verb} {sub} inside {FILES[base]}", False
    if path.startswith(("~/", "/")):
        return f"{verb} the folder {path}", False
    return _unknown(f"filesystems={entry}"), True


def _bus_sentences(policy, where):
    """(wide, narrow) for one [Session Bus Policy] or [System Bus Policy] section."""
    wide, narrow = [], []
    plain = {"see": [], "talk": [], "own": []}
    for name, value in policy.items():
        if value == "none":
            continue
        if value not in plain:
            wide.append(_unknown(f"{name}={value} on the {where} bus"))
            continue
        if value != "see" and (name == HOST_COMMAND_NAME or name.startswith(HOST_COMMAND_NAME + ".")):
            wide.append(f"Start programs outside its sandbox, by talking to Flatpak itself ({name})")
        elif name == "*":
            verb = {"see": "See", "talk": "Talk to", "own": "Take the name of"}[value]
            wide.append(f"{verb} every service on the {where} bus")
        elif name.endswith(".*"):
            verb = {"see": "See", "talk": "Talk to", "own": "Take the name of"}[value]
            wide.append(f"{verb} every service on the {where} bus whose name starts with {name[:-1]}")
        else:
            plain[value].append(name)
    for value, start in (("talk", "Talk to"), ("own", "Take the name of"), ("see", "See")):
        names = plain[value]
        if names:
            narrow.append(f"{start} {len(names)} other service{'s' if len(names) != 1 else ''} "
                          f"on the {where} bus: {', '.join(names)}")
    return wide, narrow


def parse_permissions(text):
    """Turn Flatpak's permission text into (wide, narrow): two lists of plain sentences.

    Every permission the text grants ends up in one of the two lists. One this file has
    no words for is listed by its Flatpak name, so both lists are empty only when the
    text grants nothing.
    """
    cp = configparser.ConfigParser(delimiters=("=",), interpolation=None, strict=False)
    cp.optionxform = str
    try:
        cp.read_string(text)
    except configparser.Error:
        return ["Nizho could not read this app's permission list, so what it can reach is unknown"], []
    wide, narrow = [], []

    def put(sentence, is_wide, conditional=False):
        if conditional:
            sentence += " (only in some sessions)"
        target = wide if is_wide else narrow
        if sentence not in wide and sentence not in narrow:
            target.append(sentence)

    ctx = cp["Context"] if cp.has_section("Context") else {}
    for key, table in CONTEXT_LISTS:
        for name, conditional in _granted(ctx.get(key, "")):
            if name in table:
                put(*table[name], conditional)
            else:
                put(_unknown(f"{key}={name}"), True, conditional)
    for entry, conditional in _granted(ctx.get("filesystems", "")):
        put(*_file_sentence(entry), conditional)
    for path in _opts(ctx.get("persistent", "")):
        what = "home folder" if path.strip("/") in ("", ".") else f"copy of ~/{path}"
        put(f"Keep its own private {what}, apart from yours", False)
    known = {k for k, _ in CONTEXT_LISTS} | {"filesystems", "persistent"} | CONTEXT_NOT_ACCESS
    for key in ctx:
        if key not in known and ctx[key]:
            put(_unknown(f"{key}={ctx[key]}"), True)
    for section, where in (("Session Bus Policy", "desktop"), ("System Bus Policy", "system")):
        if cp.has_section(section):
            w, n = _bus_sentences(cp[section], where)
            for s in w:
                put(s, True)
            for s in n:
                put(s, False)
    if cp.has_section("USB Devices"):
        devices = _opts(cp["USB Devices"].get("enumerable-devices", ""))
        if devices:
            put(f"List these USB devices and ask to use them: {', '.join(devices)}", False)
    for section in cp.sections():
        if section in ("Context", "Session Bus Policy", "System Bus Policy", "USB Devices"):
            continue
        if section.startswith(SECTIONS_NOT_ACCESS):
            continue
        if any(v for v in cp[section].values()):
            put(_unknown(f"the [{section}] rules"), True)
    return wide, narrow


def describe(name, about, text):
    wide, narrow = parse_permissions(text)
    lines = [name + (f": {about}" if about else ""), ""]
    if wide:
        lines.append("Broad access:")
        lines += [f"  - {s}" for s in wide]
    if narrow:
        lines.append("It can also:")
        lines += [f"  - {s}" for s in narrow]
    if not wide and not narrow:
        lines.append("It asks for no extra access.")
    lines += ["", "These are what the app asks for now. An update can change them, and the app can",
              "still ask you through your desktop to open a file or use the camera.",
              "They limit what the app reaches; they don't make it safe."]
    return "\n".join(lines)


def load_catalog():
    try:
        with open(CATALOG, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return []


def find(query, catalog):
    """Match a catalog entry by id or by name, ignoring case. None when there isn't one."""
    q = query.lower()
    for app in catalog:
        if app["id"].lower() == q or app["name"].lower() == q:
            return app
    return None


def flatpak(*args, capture=False):
    cmd = ["flatpak", *args]
    try:
        if capture:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
            return r.returncode, r.stdout, r.stderr
        return subprocess.run(cmd).returncode, "", ""
    except FileNotFoundError:
        die("Flatpak isn't installed on this system.")
    except subprocess.TimeoutExpired:
        die("Flathub didn't answer in time. Check your internet connection and try again.")


def die(msg, code=1):
    print(f"nizho: {msg}", file=sys.stderr)
    sys.exit(code)


def ensure_remote():
    """Add Flathub for this account from the file in the image, which carries Flathub's signing key.

    The address and the key come from that file, not from a download, so adding the remote trusts no web page.
    """
    if not os.path.isfile(REMOTE_FILE):
        die(f"Flathub's description is missing from this system ({REMOTE_FILE}).")
    code, _, err = flatpak("remote-add", "--user", "--if-not-exists", REMOTE, REMOTE_FILE, capture=True)
    if code != 0:
        die("couldn't add Flathub: " + (err.strip().splitlines() or ["unknown error"])[-1])


def resolve(query, any_id):
    catalog = load_catalog()
    app = find(query, catalog)
    if app:
        return app
    if "." in query and any_id:
        return {"id": query, "name": query, "about": "Not on the Nizho list; Flathub's own listing."}
    if "." in query:
        die(f"{query} isn't on the Nizho list. If you know what it is, run it again with --any.")
    die(f"no app called {query}. Try: nizho search")


def permissions_text(app_id):
    ensure_remote()
    code, out, err = flatpak("remote-info", "--user", "--show-metadata", REMOTE, app_id, capture=True)
    if code != 0:
        die(f"couldn't read {app_id} on Flathub: " + (err.strip().splitlines() or ["unknown error"])[-1])
    return out


def cmd_info(args):
    app = resolve(args[0], "--any" in args)
    print(describe(app["name"], app["about"], permissions_text(app["id"])))


def cmd_install(args):
    if not args or args[0].startswith("-"):
        die("usage: nizho install APP [--yes] [--any]")
    app = resolve(args[0], "--any" in args)
    print(describe(app["name"], app["about"], permissions_text(app["id"])))
    print(f"\nSource: Flathub, {app['id']}. Installed for your account only.\n")
    if "--yes" not in args and "-y" not in args:
        if not sys.stdin.isatty():
            die("won't install without asking; run it in a terminal or add --yes.")
        if input(f"Install {app['name']}? [y/N] ").strip().lower() not in ("y", "yes"):
            print("Nothing installed.")
            sys.exit(3)   # declined: not a failure, but not a success either
    sys.exit(flatpak("install", "--user", "-y", "--noninteractive", REMOTE, app["id"])[0])


def cmd_remove(args):
    if not args or args[0].startswith("-"):
        die("usage: nizho remove APP [--data] [--yes]")
    app = find(args[0], load_catalog()) or {"id": args[0], "name": args[0]}
    flags = ["--delete-data"] if "--data" in args else []
    if "--yes" not in args and "-y" not in args:
        if not sys.stdin.isatty():
            die("won't remove without asking; run it in a terminal or add --yes.")
        extra = " and everything it saved" if flags else ""
        if input(f"Remove {app['name']}{extra}? [y/N] ").strip().lower() not in ("y", "yes"):
            print("Nothing was removed.")
            sys.exit(3)
    sys.exit(flatpak("uninstall", "--user", "-y", *flags, app["id"])[0])


def cmd_update(args):
    if args and args[0].startswith("-"):
        die("usage: nizho update [APP]")
    target = []
    if args:
        target = [(find(args[0], load_catalog()) or {"id": args[0]})["id"]]
    ensure_remote()
    sys.exit(flatpak("update", "--user", "-y", "--noninteractive", *target)[0])


def cmd_search(args):
    words = [w.lower() for w in args if not w.startswith("-")]
    shown = [a for a in load_catalog() if all(w in (a["name"] + " " + a["about"] + " " + a["category"]).lower() for w in words)]
    if not shown:
        die("nothing on the Nizho list matches. The list is short on purpose.")
    for a in shown:
        print(f"{a['name']:<14} {a['about']}")
    print("\nA selection by Nizho, not an audit. Install with: nizho install NAME")


def cmd_list(_args):
    code, out, err = flatpak("list", "--user", "--app", "--columns=name,application", capture=True)
    if code != 0:
        die(err.strip() or "couldn't list apps")
    print(out.strip() or "No apps installed with nizho yet.")


COMMANDS = {"install": cmd_install, "remove": cmd_remove, "update": cmd_update, "search": cmd_search, "info": cmd_info, "list": cmd_list}


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help") or argv[0] not in COMMANDS:
        print(__doc__.strip())
        return 0 if not argv or argv[0] in ("-h", "--help", "help") else 2
    if argv[0] == "info" and len(argv) < 2:
        die("usage: nizho info APP")
    COMMANDS[argv[0]](argv[1:])
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
