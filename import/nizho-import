class BadFile(Exception):
    pass


class Folder:
    def __init__(self, name, added=None):
        self.name = name
        self.added = added
        self.kids = []
        self.urls = set()


class Mark:
    def __init__(self, title, url, added=None):
        self.title = title
        self.url = url
        self.added = added


class Tally:
    def __init__(self):
        self.bookmarks = 0
        self.folders = 0
        self.skipped = {}

    def skip(self, why):
        self.skipped[why] = self.skipped.get(why, 0) + 1

    def add(self, other):
        self.bookmarks += other.bookmarks
        self.folders += other.folders
        for why, n in other.skipped.items():
            self.skipped[why] = self.skipped.get(why, 0) + n


class Found:
    def __init__(self, browser, kind, path, owner, profile):
        self.browser, self.kind, self.path, self.owner, self.profile = browser, kind, path, owner, profile

    def label(self):
        return " / ".join(p for p in (self.owner, self.profile) if p)


def clean_text(s, limit=MAX_TITLE):
    """Keep text readable and safe to write: no control characters, one line, at most `limit` characters."""
    if not isinstance(s, str):
        return ""
    out = []
    for ch in s:
        if ch in "\t\n\r":
            out.append(" ")
        elif unicodedata.category(ch) in ("Cc", "Cs"):
            continue
        else:
            out.append(ch)
    return " ".join("".join(out).split())[:limit]


def clean_url(s):
    if not isinstance(s, str):
        return ""
    return "".join(ch for ch in s if unicodedata.category(ch) not in ("Cc", "Cs")).strip()


def chrome_time(value):
    """Chrome counts microseconds since 1601-01-01. Returns Unix seconds, or None when unusable."""
    try:
        us = int(value)
    except (TypeError, ValueError):
        return None
    if us <= 0:
        return None
    secs = us // 1000000 - CHROME_EPOCH_OFFSET
    return secs if 0 < secs < 4102444800 else None


def unix_micro_time(value):
    try:
        us = int(value)
    except (TypeError, ValueError):
        return None
    secs = us // 1000000
    return secs if 0 < secs < 4102444800 else None


def add_mark(parent, title, url, added, tally):
    """Add one bookmark to a folder, or count why it was left out."""
    tally.bookmarks += 1
    url = clean_url(url)
    low = url.lower()
    if not url:
        tally.skip(SKIP_ADDRESS)
    elif low.startswith(("javascript:", "data:", "vbscript:")):
        tally.skip(SKIP_SCRIPT)
    elif low.startswith("place:"):
        tally.skip(SKIP_PLACE)
    elif url in parent.urls:
        tally.skip(SKIP_DUP)
    else:
        parent.urls.add(url)
        parent.kids.append(Mark(clean_text(title) or url, url, added))


def add_folder(parent, name, added, tally):
    tally.folders += 1
    f = Folder(clean_text(name) or "Untitled folder", added)
    parent.kids.append(f)
    return f


def read_limited(path):
    with open_source(path) as f:
        data = f.read(MAX_BOOKMARK_FILE + 1)
    if len(data) > MAX_BOOKMARK_FILE:
        raise BadFile("the file is too large to be a bookmarks file")
    return data


# --- Chrome, Edge, Brave, Vivaldi, Opera, Chromium

def parse_chrome(path, tally):
    data = read_limited(path)
    try:
        doc = json.loads(data.decode("utf-8-sig"))
    except (ValueError, RecursionError):
        raise BadFile("the file is damaged or is not a Chrome style bookmarks file (not valid JSON)")
    roots = doc.get("roots") if isinstance(doc, dict) else None
    if not isinstance(roots, dict):
        raise BadFile("the file has no bookmark folders (it is not a Chrome style bookmarks file)")
    top = []
    for key, label in (("bookmark_bar", "Bookmarks bar"), ("other", "Other bookmarks"),
                       ("synced", "Mobile bookmarks")):
        node = roots.get(key)
        if not isinstance(node, dict):
            continue
        folder = Folder(label)
        _chrome_children(node, folder, tally, 0)
        if folder.kids:
            top.append(folder)
    return top


def _chrome_children(node, parent, tally, depth):
    kids = node.get("children")
    if not isinstance(kids, list):
        return
    for child in kids:
        if not isinstance(child, dict):
            tally.skip(SKIP_DAMAGED)
            continue
        kind = child.get("type")
        if kind == "folder":
            if depth >= MAX_DEPTH:
                tally.skip(SKIP_DEEP)
                continue
            sub = add_folder(parent, child.get("name"), chrome_time(child.get("date_added")), tally)
            _chrome_children(child, sub, tally, depth + 1)
        elif kind == "url":
            add_mark(parent, child.get("name"), child.get("url"), chrome_time(child.get("date_added")), tally)
        else:
            tally.skip(SKIP_DAMAGED)


