// Nizho boot splash, "Awakening". Design tokens: accent #4DB491. No sound.
//
// Starting: a point of light wakes at the top of the ribbon, pens of light trace the outline of the
// ribbon and both stones, and the light floods inward and becomes the mark (3.05 s). Then a line of
// light draws out under the mark like a horizon, the letters of NIZHO rise from it one by one, the
// line opens in the middle and OPERATING SYSTEM settles into the gap, and a glint runs once across
// the name (6.3 s). Then it rests: the glow breathes, and now and then a glint runs along the
// ribbon, so a slow start still shows that something is happening.
// Shutting down or restarting: the beats play backwards (the tagline goes, the line closes, the
// letters sink, the line draws back in), the mark drains back into its outline, the outline draws
// back into the point of light, and the point breathes there until the power goes.
// While a password prompt shows, the line and the tagline are hidden so the prompt stays clear.
//
// Normal boot shows no spinner and no progress bar: Plymouth's boot "progress" is an estimate from
// the previous boot and can stall or jump, so we don't present it as a measurement. System updates
// report real progress, so there we draw a real bar and say not to power off.
//
// make-assets.py draws the opening as frames (Plymouth can't trace or mask while it runs) at AF
// pixels a unit, and the letters, line, tagline and prompt at A pixels a unit, where a unit is one
// pixel of a 1080-line screen; everything here is laid out in units and scaled to the screen. Frames
// are loaded one at a time as they are shown, so they never all sit in memory. After the opening
// everything moves by opacity, position and width only: Plymouth has no live blur or mask.

Window.SetBackgroundTopColor(0.027, 0.031, 0.055);
Window.SetBackgroundBottomColor(0.020, 0.024, 0.035);

// @FRAMES@
global.PROMPT_DY = 270;
global.BOX_DY = 326;
global.STATUS_DY = 270;
global.MSG_DY = 420;
global.STORY = 6.3;                           // the last beat (the glint across the name) ends here
global.OPENED = 3.05;                         // the opening frames end, the mark is formed
global.LAST = (global.NA - 1) / global.FPS;   // story time of the last opening frame
global.HOLD = 0.4;                            // shutdown ends on this moment: the point alone

// Screen geometry. The display often changes size during boot (firmware framebuffer -> real GPU
// driver at native resolution), so layout() runs again whenever the size changes.
global.sw = 0;
global.sh = 0;

fun geometry() {
    global.wx = Window.GetX();
    global.wy = Window.GetY();
    global.sw = Window.GetWidth();
    global.sh = Window.GetHeight();
    global.f = Math.Clamp(Math.Min(global.sh / 1080, global.sw / 1100), 0.5, 2.4);
    global.cx = global.wx + global.sw / 2;
    global.cy = global.wy + global.sh / 2;
}

// IMG was drawn at A pixels a unit; scale it to the screen.
fun scaled(img, a) {
    k = global.f / a;
    return img.Scale(Math.Int(img.GetWidth() * k + 0.5), Math.Int(img.GetHeight() * k + 0.5));
}

// The same, drawn K times larger (the opening frames and the glow are shown at a size of their own).
fun scaledk(img, a, k) {
    local.s = global.f * k / a;
    return img.Scale(Math.Int(img.GetWidth() * local.s + 0.5), Math.Int(img.GetHeight() * local.s + 0.5));
}

// Centre IMG's sprite on the point UX, UY units from the screen's centre.
fun put(sprite, img, ux, uy) {
    sprite.SetX(Math.Int(global.cx + ux * global.f - img.GetWidth() / 2));
    sprite.SetY(Math.Int(global.cy + uy * global.f - img.GetHeight() / 2));
}

fun label(text, size, r, g, b) {
    return Image.Text(text, r, g, b, 1, "Inter, Inter Variable, Sans " + Math.Int(size * global.f));
}

// --- text helpers. Plymouth strings have CharAt and SubString (bytes); Length is too new to rely on.
// Plymouth looks a name up in the global scope before making a local one, and this script's top
// level uses i, n and the like, so these helpers keep their counters in local. explicitly.
fun str_len(s) {
    local.n = 0;
    while (s.CharAt(local.n) != "") local.n = local.n + 1;
    return local.n;
}
fun str_find(s, sub, from) {
    local.ls = str_len(s);
    local.lsub = str_len(sub);
    for (local.j = from; local.j + local.lsub <= local.ls; local.j = local.j + 1) {
        if (s.SubString(local.j, local.j + local.lsub) == sub) return local.j;
    }
    return -1;
}
global.ALNUM = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
// systemd puts an emoji in front of some messages (the low-battery one at boot). The splash font
// has no emoji, so it would show as an empty box: start the line at its first letter or digit.
fun clean_message(text) {
    local.len = str_len(text);
    local.k = 0;
    while (local.k < local.len && str_find(global.ALNUM, text.CharAt(local.k), 0) < 0) local.k = local.k + 1;
    return text.SubString(local.k, local.len);
}
// systemd-cryptsetup asks "Please enter passphrase for disk nizho-root (luks-<uuid>):", which runs
// off the screen and says nothing a person needs. Say the same thing in plain words; any other
// prompt is shown as it is.
fun prompt_words(text) {
    if (text.SubString(0, 13) != "Please enter ") return text;
    local.e = str_find(text, " for disk ", 13);
    if (local.e < 0) local.e = str_find(text, ":", 13);
    if (local.e < 0) return text;
    local.what = text.SubString(13, local.e);
    if (local.what == "LUKS2 token PIN") local.what = "PIN";
    return "Enter the " + local.what + " to unlock the disk";
}

// CSS cubic-bezier(X1, Y1, X2, Y2) at X (0..1), by bisection.
fun bez(x1, y1, x2, y2, x) {
    local.lo = 0;
    local.hi = 1;
    for (local.k = 0; local.k < 14; local.k++) {
        local.s = (local.lo + local.hi) / 2;
        local.u = 1 - local.s;
        local.bx = 3 * local.u * local.u * local.s * x1 + 3 * local.u * local.s * local.s * x2 + local.s * local.s * local.s;
        if (local.bx < x) local.lo = local.s;
        else local.hi = local.s;
    }
    local.s = (local.lo + local.hi) / 2;
    local.u = 1 - local.s;
    return 3 * local.u * local.u * local.s * y1 + 3 * local.u * local.s * local.s * y2 + local.s * local.s * local.s;
}
fun clamp01(v) { return Math.Clamp(v, 0, 1); }
fun eout(x) { return bez(0.16, 1, 0.3, 1, Math.Clamp(x, 0, 1)); }   // the preview's OUT
fun eio(x) { return bez(0.65, 0, 0.35, 1, Math.Clamp(x, 0, 1)); }   // the preview's IO
fun seg(t, a, b) { return Math.Clamp((t - a) / (b - a), 0, 1); }
fun ease(x) { x = clamp01(x); return x * x * (3 - 2 * x); }
fun inout(x) { x = clamp01(x); return 0.5 - 0.5 * Math.Cos(Math.Pi * x); }

mode = Plymouth.GetMode();
global.leaving = (mode == "shutdown" || mode == "reboot");
global.updating_mode = (mode == "updates" || mode == "system-upgrade" || mode == "firmware-upgrade");

fun sprite_at(z) {
    sp = Sprite();
    sp.SetZ(z);
    sp.SetOpacity(0);
    return sp;
}

// --- pictures and sprites --------------------------------------------------------------------------
halo.src = Image("halo.png");    halo.sprite = sprite_at(2);
anim.sprite = sprite_at(3);
glint.sprite = sprite_at(4);
global.acur = -1;
global.gcur = -1;
global.wcur = -1;
for (i = 0; i < 5; i++) {
    letter[i].src = Image("l" + i + ".png");
    letter[i].sprite = sprite_at(5);
}
wglint.sprite = sprite_at(6);                 // the glint across the name
line[0].src = Image("lineL.png");             // the horizon line, its left and right halves
line[1].src = Image("lineR.png");
line[0].sprite = sprite_at(3);
line[1].sprite = sprite_at(3);
global.line_w = -1;
for (i = 0; i < global.TAG_N; i++) {          // OPERATING SYSTEM, a picture per glyph (none for the space)
    if (global.TAG_HAS[i]) tag[i].src = Image("o" + i + ".png");
    tag[i].sprite = sprite_at(5);
}

// The opening frame for story time T, loaded only when it changes.
fun show_frame(T, op) {
    local.i = Math.Int(T * global.FPS + 0.5);
    if (local.i < 0) local.i = 0;
    if (local.i > global.NA - 1) local.i = global.NA - 1;
    if (local.i != global.acur) {
        global.anim.image = scaledk(Image("a" + local.i + ".png"), global.AF, global.MARK_K);
        anim.sprite.SetImage(global.anim.image);
        put(anim.sprite, global.anim.image, 0, global.MARK_DY);
        global.acur = local.i;
    }
    anim.sprite.SetOpacity(clamp01(op));
}

// The glint, G of the way along the ribbon (outside 0..1: none), at opacity OP.
fun show_glint(g, op) {
    if (g <= 0 || g >= 1 || op <= 0) {
        glint.sprite.SetOpacity(0);
    } else {
        local.i = Math.Int(g * global.NG);
        if (local.i > global.NG - 1) local.i = global.NG - 1;
        if (local.i != global.gcur) {
            global.glint.image = scaledk(Image("g" + local.i + ".png"), global.AF, global.MARK_K);
            glint.sprite.SetImage(global.glint.image);
            put(glint.sprite, global.glint.image, 0, global.MARK_DY);
            global.gcur = local.i;
        }
        glint.sprite.SetOpacity(clamp01(op));
    }
}

// Letter I, P of the way up (0..1): it rises WORD_RISE units as it fades in.
fun show_letter(i, p) {
    letter[i].sprite.SetOpacity(clamp01(p));
    put(letter[i].sprite, global.letter[i].image, 0, global.WORD_DY + global.WORD_RISE * (1 - clamp01(p)));
}

// The glint across the name, P of the way (outside 0..1: none).
fun show_wglint(p) {
    if (p <= 0 || p >= 1) {
        wglint.sprite.SetOpacity(0);
    } else {
        local.i = Math.Int(p * (global.NW - 1) + 0.5);
        if (local.i != global.wcur) {
            global.wglint.image = scaled(Image("s" + local.i + ".png"), global.A);
            wglint.sprite.SetImage(global.wglint.image);
            put(wglint.sprite, global.wglint.image, 0, global.WORD_DY);
            global.wcur = local.i;
        }
        wglint.sprite.SetOpacity(1);
    }
}

// The horizon line. GROW (0..1) is how far it has drawn out from the middle, OPEN (0..1) how far it
// has opened in the middle. Each half is one picture scaled by width, with room for its glow at both ends.
fun show_line(grow, open) {
    local.vis = 1;
    if (global.prompting == 1) local.vis = 0;
    local.gap = 190 * open;
    local.seg = Math.Max(0, global.LINE_HALF * grow - local.gap) * (1 - 0.55 * open);
    local.op = (0.85 - 0.35 * open) * local.vis;
    if (local.seg < 0.5 || local.op <= 0) {
        line[0].sprite.SetOpacity(0);
        line[1].sprite.SetOpacity(0);
    } else {
        local.k = local.seg / global.LINE_HALF * global.f;
        local.w = Math.Int((global.LINE_HALF + 2 * global.LINE_PAD) * local.k + 0.5);
        local.h = Math.Int(line[0].src.GetHeight() * global.f / global.A + 0.5);
        if (local.w != global.line_w) {
            global.line[0].image = line[0].src.Scale(local.w, local.h);
            global.line[1].image = line[1].src.Scale(local.w, local.h);
            line[0].sprite.SetImage(global.line[0].image);
            line[1].sprite.SetImage(global.line[1].image);
            global.line_w = local.w;
        }
        local.padpx = global.LINE_PAD * local.k;
        local.y = Math.Int(global.cy + global.LINE_DY * global.f - local.h / 2);
        line[0].sprite.SetX(Math.Int(global.cx - local.gap * global.f + local.padpx - local.w));
        line[1].sprite.SetX(Math.Int(global.cx + local.gap * global.f - local.padpx));
        line[0].sprite.SetY(local.y);
        line[1].sprite.SetY(local.y);
        line[0].sprite.SetOpacity(local.op);
        line[1].sprite.SetOpacity(local.op);
    }
}

// OPERATING SYSTEM, P of the way settled (0..1): it fades in, rises 6 units, and its letters draw
// together from 0.62 em to 0.42 em apart. The block stays centred on the screen.
fun show_tag(p) {
    local.vis = 1;
    if (global.prompting == 1) local.vis = 0;
    local.op = 0.78 * clamp01(p) * local.vis;
    local.ls = (global.TAG_TRACK0 + (global.TAG_TRACK1 - global.TAG_TRACK0) * clamp01(p)) * global.TAG_SIZE;
    local.x = -global.TAG_SUM / 2 - (global.TAG_N - 1) * local.ls / 2;
    local.y = Math.Int(global.cy + (global.TAG_BASE_DY - global.TAG_BASE + 6 * (1 - clamp01(p))) * global.f);
    for (local.k = 0; local.k < global.TAG_N; local.k++) {
        if (global.TAG_HAS[local.k]) {
            tag[local.k].sprite.SetOpacity(local.op);
            if (local.op > 0) {
                tag[local.k].sprite.SetX(Math.Int(global.cx + (local.x - global.TAG_PAD) * global.f));
                tag[local.k].sprite.SetY(local.y);
            }
        }
        local.x = local.x + global.TAG_ADV[local.k] + local.ls;
    }
}

// --- status line (shutdown / restart / updates) and the real bar for updates ---------------------
status.text = "";
if (mode == "shutdown") status.text = "Shutting down";
if (mode == "reboot") status.text = "Restarting";
if (global.updating_mode) status.text = "Installing updates. Don't turn off your computer.";
status.sprite = sprite_at(15);
bar.backsrc = Image("barback.png");
bar.back = sprite_at(15);
fill_bar.image = Image("bar.png");
fill_bar.sprite = sprite_at(16);
global.updating = 0;   // 1 once a real system-update progress arrives
global.progress = 0;

// --- boot messages (e.g. a disk check), one line under everything ---------------------------------
msg.sprite = sprite_at(16);
fun message_callback(text) {
    global.msg.image = label(clean_message(text), 17, 0.70, 0.73, 0.78);
    msg.sprite.SetImage(global.msg.image);
    put(msg.sprite, global.msg.image, 0, global.MSG_DY);
    msg.sprite.SetOpacity(1);
}
Plymouth.SetMessageFunction(message_callback);

fun hide_message_callback(text) {
    msg.sprite.SetOpacity(0);
}
Plymouth.SetHideMessageFunction(hide_message_callback);

// --- passphrase prompt pieces ----------------------------------------------------------------------
prompt.sprite = sprite_at(20);
box.src = Image("entry.png");
box.sprite = sprite_at(20);
dots.sprite = sprite_at(21);
global.dotmax = 32;
dot.src = Image("dot.png");
for (i = 0; i < global.dotmax; i++) dot[i] = sprite_at(21);
global.dotcount = 0;

// --- layout: (re)scale and position everything for the current screen ------------------------------
fun layout() {
    geometry();
    global.acur = -1;     // reload the current frames at the new size
    global.gcur = -1;
    global.halo.image = scaledk(halo.src, global.AF, 2 * global.MARK_K);
    halo.sprite.SetImage(global.halo.image);
    put(halo.sprite, global.halo.image, 0, global.MARK_DY);
    global.wcur = -1;
    global.line_w = -1;
    for (i = 0; i < 5; i++) {
        global.letter[i].image = scaled(letter[i].src, global.A);
        letter[i].sprite.SetImage(global.letter[i].image);
        put(letter[i].sprite, global.letter[i].image, 0, global.WORD_DY);
    }
    for (i = 0; i < global.TAG_N; i++) {
        if (global.TAG_HAS[i]) {
            global.tag[i].image = scaled(tag[i].src, global.A);
            tag[i].sprite.SetImage(global.tag[i].image);
        }
    }
    if (status.text != "") {
        global.status.image = label(status.text, 20, 0.85, 0.88, 0.92);
        status.sprite.SetImage(global.status.image);
        put(status.sprite, global.status.image, 0, global.STATUS_DY);
    }
    global.bar.w = Math.Int(260 * global.f);
    global.bar.h = Math.Max(3, Math.Int(4 * global.f));
    global.bar.x = Math.Int(global.cx - global.bar.w / 2);
    global.bar.y = Math.Int(global.cy + (global.STATUS_DY + 50) * global.f);
    bar.back.SetImage(bar.backsrc.Scale(global.bar.w, global.bar.h));
    bar.back.SetX(global.bar.x);
    bar.back.SetY(global.bar.y);
    fill_bar.sprite.SetX(global.bar.x);
    fill_bar.sprite.SetY(global.bar.y);
    if (global.updating) draw_bar();

    global.box.image = scaled(box.src, global.A);
    box.sprite.SetImage(global.box.image);
    put(box.sprite, global.box.image, 0, global.BOX_DY);
    global.dot.image = scaled(dot.src, global.A);
    if (global.prompt.image) put(prompt.sprite, global.prompt.image, 0, global.PROMPT_DY);
    if (global.msg.image) put(msg.sprite, global.msg.image, 0, global.MSG_DY);
    draw_dots(global.dotcount);
}

fun draw_bar() {
    w = Math.Int(global.bar.w * Math.Clamp(global.progress / 100, 0, 1));
    if (w < 1) w = 1;
    fill_bar.sprite.SetImage(fill_bar.image.Scale(w, global.bar.h));
}

// --- starting: the opening, the Horizon beats, then the rest ----------------------------------------
fun story(t) {
    show_frame(t, 1);
    halo.sprite.SetOpacity(ease(seg(t, global.OPENED, global.OPENED + 0.55)) * (0.35 + 0.25 * (0.5 + 0.5 * Math.Sin(1.6 * (t - global.OPENED)))));
    show_glint(-1, 0);
    show_line(eout(seg(t, global.T_LINE, global.T_LINE + 0.7)), eio(seg(t, global.T_OPEN, global.T_OPEN + 0.8)));
    for (local.k = 0; local.k < 5; local.k++) {
        show_letter(local.k, eout(seg(t, global.T_LETTERS + 0.09 * local.k, global.T_LETTERS + 0.75 + 0.09 * local.k)));
    }
    show_tag(eout(seg(t, global.T_TAG, global.T_TAG + 0.9)));
    show_wglint(seg(t, global.T_GLINT, global.T_GLINT + 1.1));
}

fun rest(r) {
    show_frame(global.LAST, 1);
    halo.sprite.SetOpacity(0.35 + 0.25 * (0.5 + 0.5 * Math.Sin(1.6 * (r + global.STORY - global.OPENED))));
    g = -1;
    if (r > 1.6) {
        rr = r - 1.6;
        g = (rr - 7.0 * Math.Int(rr / 7.0)) / 1.4;
    }
    show_glint(g, 0.8 * Math.Sin(Math.Pi * clamp01(g)));
    show_line(1, 1);
    for (local.k = 0; local.k < 5; local.k++) show_letter(local.k, 1);
    show_tag(1);
    show_wglint(-1);
}

// --- shutting down or restarting ------------------------------------------------------------------
// The beats play backwards in the first 0.95 s (the tagline goes, the line closes, the letters sink,
// the line draws back in); the mark drains from 0.8 s on, as before.
fun leave(t) {
    show_tag(1 - ease(seg(t, 0, 0.3)));
    show_line(1 - eio(seg(t, 0.5, 0.95)), 1 - eio(seg(t, 0, 0.55)));
    for (local.k = 0; local.k < 5; local.k++) {
        show_letter(local.k, 1 - ease(seg(t, 0.1 + 0.04 * local.k, 0.45 + 0.04 * local.k)));
    }
    show_wglint(-1);
    halo.sprite.SetOpacity(0);
    show_glint(-1, 0);
    T = global.LAST - (global.LAST - global.HOLD) * inout(seg(t, 0.8, 2.75));
    op = 1;
    if (t > 2.75) op = 0.65 + 0.35 * Math.Cos(2 * Math.Pi * (t - 2.75) / 3.0);
    show_frame(T, op);
    status.sprite.SetOpacity(seg(t, 1.75, 2.15));
}

// --- the refresh loop (50 times a second) --------------------------------------------------------------
// Time comes from Plymouth's boot clock (the progress callback, about 30 times a second) when it
// runs, so the opening keeps its pace when a slow machine draws fewer than 50 frames a second;
// counting frames is the fallback.
global.counter = 0;
global.clock0 = -1;
global.tlast = 0;
fun boot_progress_callback(duration, progress) {
    if (global.clock0 < 0) global.clock0 = duration - global.counter / 50.0;
    global.clock = duration - global.clock0;
    global.clock_at = global.counter;
}
Plymouth.SetBootProgressFunction(boot_progress_callback);

fun refresh_callback() {
    if (Window.GetWidth() != global.sw || Window.GetHeight() != global.sh) layout();
    global.counter++;
    t = global.counter / 50.0;
    if (global.clock0 >= 0) t = global.clock + (global.counter - global.clock_at) / 50.0;
    if (t < global.tlast) t = global.tlast;
    global.tlast = t;
    // A prompt wins over shutting down. systemd's boot battery check switches the splash to
    // shutdown mode while the disk prompt is still open (plugging in the charger lets the boot go
    // on), so the prompt stays usable over the resting mark and "Shutting down" waits.
    if (global.leaving && global.prompting != 1) leave(t);
    else if (global.leaving) rest(t);
    else if (t < global.STORY) story(t);
    else rest(t - global.STORY);
    if (global.updating_mode && global.leaving == 0) {
        a = seg(t, 3.0, 3.6);
        if (global.prompting != 1) status.sprite.SetOpacity(a);
        bar.back.SetOpacity(a);
        fill_bar.sprite.SetOpacity(a * global.updating);
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

// Real progress only during system updates.
fun system_update_callback(progress) {
    global.updating = 1;
    global.progress = progress;
    draw_bar();
}
Plymouth.SetSystemUpdateFunction(system_update_callback);

// --- passphrase / question prompts -------------------------------------------------------------------
fun show_prompt(text) {
    global.prompting = 1;
    global.prompt.image = label(text, 20, 0.96, 0.97, 0.98);
    prompt.sprite.SetImage(global.prompt.image);
    put(prompt.sprite, global.prompt.image, 0, global.PROMPT_DY);
    prompt.sprite.SetOpacity(1);
    box.sprite.SetOpacity(1);
    status.sprite.SetOpacity(0);
}

// Draw n dots centred in the box. Past what fits, the row stops growing; it only shows that typing
// is happening, never the passphrase length beyond that.
fun draw_dots(n) {
    w = global.dot.image.GetWidth();
    step = Math.Int(w * 1.9);
    fit = Math.Int((global.box.image.GetWidth() - 48 * global.f - w) / step) + 1;
    n = Math.Min(n, Math.Min(fit, global.dotmax));
    x0 = Math.Int(global.cx - ((n - 1) * step + w) / 2);
    y = Math.Int(global.cy + global.BOX_DY * global.f - global.dot.image.GetHeight() / 2);
    for (i = 0; i < global.dotmax; i++) {
        if (i < n) {
            dot[i].SetImage(global.dot.image);
            dot[i].SetX(x0 + i * step);
            dot[i].SetY(y);
            dot[i].SetOpacity(1);
        } else {
            dot[i].SetOpacity(0);
        }
    }
    global.dotcount = n;
}

fun display_password_callback(prompt_text, bullets) {
    text = prompt_words(prompt_text);
    if (text == "") text = "Enter the passphrase to unlock this disk";
    show_prompt(text);
    dots.sprite.SetOpacity(0);
    draw_dots(bullets);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_question_callback(prompt_text, entry) {
    show_prompt(prompt_words(prompt_text));
    draw_dots(0);
    global.dots.image = label(entry, 26, 0.09, 0.78, 0.52);
    dots.sprite.SetImage(global.dots.image);
    put(dots.sprite, global.dots.image, 0, global.BOX_DY);
    dots.sprite.SetOpacity(1);
}
Plymouth.SetDisplayQuestionFunction(display_question_callback);

// After the answer is accepted: clear the prompt so it doesn't linger.
fun display_normal_callback() {
    global.prompting = 0;
    prompt.sprite.SetOpacity(0);
    box.sprite.SetOpacity(0);
    dots.sprite.SetOpacity(0);
    draw_dots(0);
    if (status.text != "" && global.leaving) status.sprite.SetOpacity(1);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

layout();
