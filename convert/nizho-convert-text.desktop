[Desktop Entry]
Type=Service
MimeType=text/plain;
Actions=docx;pdf;odt;
X-KDE-Submenu=Convert to
X-KDE-Priority=TopLevel

[Desktop Action docx]
Name=Word
Exec=nizho-convert docx %F
Icon=x-office-document

[Desktop Action pdf]
Name=PDF
Exec=nizho-convert pdf %F
Icon=application-pdf

[Desktop Action odt]
Name=ODT (LibreOffice)
Exec=nizho-convert odt %F
Icon=x-office-document
