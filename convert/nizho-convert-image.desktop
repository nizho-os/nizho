[Desktop Entry]
Type=Service
MimeType=image/png;image/jpeg;image/webp;image/gif;image/bmp;image/tiff;image/avif;
Actions=png;jpg;webp;avif;pdf;tiff;bmp;text;
X-KDE-Submenu=Convert to
X-KDE-Priority=TopLevel

[Desktop Action png]
Name=PNG
Exec=nizho-convert png %F
Icon=image-x-generic

[Desktop Action jpg]
Name=JPEG
Exec=nizho-convert jpg %F
Icon=image-x-generic

[Desktop Action webp]
Name=WebP
Exec=nizho-convert webp %F
Icon=image-x-generic

[Desktop Action pdf]
Name=PDF
Exec=nizho-convert pdf %F
Icon=image-x-generic

[Desktop Action avif]
Name=AVIF
Exec=nizho-convert avif %F
Icon=image-x-generic

[Desktop Action tiff]
Name=TIFF
Exec=nizho-convert tiff %F
Icon=image-x-generic

[Desktop Action bmp]
Name=BMP
Exec=nizho-convert bmp %F
Icon=image-x-generic

[Desktop Action text]
Name=Text (read by OCR)
Exec=nizho-convert text %F
Icon=text-plain
