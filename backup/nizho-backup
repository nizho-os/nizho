#!/usr/bin/env python3
"""nizho-backup: encrypted backups of your files to a drive you choose.

    nizho-backup setup --to FOLDER   make an encrypted backup there and print the recovery key once
    nizho-backup now                 back up your files now (the daily timer runs this too)
    nizho-backup status [--json]     when the last backup ran, and whether the drive is connected
    nizho-backup list                list the saved backups
    nizho-backup snapshots --json    the saved backups as JSON: id and time, newest first
    nizho-backup ls [PATH] [--snapshot ID] [--json]
                                     list what is inside PATH (relative to your home folder) in a backup
    nizho-backup restore PATH --to DIR [--snapshot ID]
                                     put PATH (relative to your home folder) back into DIR
    nizho-backup tidy                drop old backups: keep 7 daily, 4 weekly, 6 monthly

What it covers: files in your home folder, minus caches and the trash. It does not
cover the system itself; updates keep the previous system image for that.
It is not an offsite backup. It protects against deleting something or a failed
disk, and it does not protect against a fire or a theft that takes the backup drive too.
Backups are encrypted with a recovery key kept in ~/.config/nizho/backup.key. If you lose
this computer and the key, the backup cannot be opened, so keep a copy of the key elsewhere.
"""
import argparse
import contextlib
import datetime as dt
import fcntl
import json
import os
import re
import secrets
import shutil
import subprocess
import sys
import tempfile

EXCLUDES = [".cache", ".local/share/Trash", ".var/app/*/cache", ".var/app/*/.cache", "*/node_modules", ".thumbnails", ".config/nizho/backup.key"]
KEEP = ["--keep-daily", "7", "--keep-weekly", "4", "--keep-monthly", "6"]


class Fail(Exception):
    pass


def config_dir():
    return os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "nizho")


def config_path():
    return os.path.join(config_dir(), "backup.json")


def key_path():
    return os.path.join(config_dir(), "backup.key")


def load_config():
    try:
        with open(config_path()) as f:
            cfg = json.load(f)
    except FileNotFoundError:
        return None
    except (OSError, ValueError) as e:
        raise Fail(f"The backup settings could not be read ({e}).")
    if not isinstance(cfg, dict) or not isinstance(cfg.get("repo"), str) \
            or not isinstance(cfg.get("paths"), list) or not all(isinstance(x, str) for x in cfg["paths"]):
        raise Fail(f"The backup settings in {config_path()} are damaged. Move that file away to set up again.")
    return cfg


def save_config(cfg):
    os.makedirs(config_dir(), mode=0o700, exist_ok=True)
    tmp = config_path() + ".tmp"
    with open(tmp, "w") as f:
        json.dump(cfg, f, indent=2)
    os.replace(tmp, config_path())


def lock_path():
    return os.path.join(config_dir(), "backup.lock")


class Busy(Fail):
    pass


@contextlib.contextmanager
def exclusive():
    """Only one command that changes the backup runs at a time (two timers, two clicks)."""
    os.makedirs(config_dir(), mode=0o700, exist_ok=True)
    fd = os.open(lock_path(), os.O_WRONLY | os.O_CREAT | os.O_CLOEXEC, 0o600)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            raise Busy("Another nizho-backup is already running. Wait for it to finish.")
        yield
    finally:
        os.close(fd)


def restic_bin():
    path = os.environ.get("NIZHO_RESTIC") or shutil.which("restic")
    if not path:
        raise Fail("restic is not installed, so backups are not available.")
    return path


def restic_process(cfg, args, capture=False, ok=(0,)):
    env = dict(os.environ, RESTIC_REPOSITORY=cfg["repo"], RESTIC_PASSWORD_FILE=key_path(), RESTIC_PROGRESS_FPS="0")
    try:
        p = subprocess.run([restic_bin()] + args, env=env, text=True, capture_output=capture, stdin=subprocess.DEVNULL)
    except OSError as e:
        raise Fail(f"restic could not be started ({e}).")
    if p.returncode not in ok:
        detail = ((p.stderr or "").strip().splitlines() or [""])[-1] if capture else ""
        raise Fail(f"restic stopped with an error (code {p.returncode}). {detail}".strip())
    return p


def run_restic(cfg, args, capture=False):
    p = restic_process(cfg, args, capture)
    return p.stdout if capture else ""


def need_config():
    cfg = load_config()
    if not cfg:
        raise Fail("Backups are not set up yet. Run: nizho-backup setup --to FOLDER")
    return cfg


def drive_connected(cfg):
    return os.path.isdir(cfg["repo"]) and os.path.exists(os.path.join(cfg["repo"], "config"))


def cmd_setup(a):
    if load_config():
        raise Fail("Backups are already set up. The backup folder is " + load_config()["repo"] + ".")
    dest = os.path.abspath(os.path.expanduser(a.to))
    home = os.path.expanduser("~")
    # Compare real paths, so a symlink to a folder in your home does not get around the check.
    rdest, rhome = os.path.realpath(dest), os.path.realpath(home)
    if rdest == rhome or rdest.startswith(rhome + os.sep) and not a.allow_home:
        raise Fail("The backup folder is inside your home folder, so it would go with your files if the disk fails. "
                   "Choose a folder on an external drive, or add --allow-home to do it anyway.")
    if os.path.exists(os.path.join(dest, "config")):
        raise Fail("That folder already holds a backup. Choose an empty folder.")
    os.makedirs(dest, exist_ok=True)
    os.makedirs(config_dir(), mode=0o700, exist_ok=True)
    if os.path.lexists(key_path()):
        raise Fail(f"A recovery key file already exists at {key_path()} but no backup is set up. "
                   "It may belong to a backup you still need, so it was not touched. Move it somewhere safe, then try again.")
    key = secrets.token_urlsafe(24)
    cfg = {"repo": dest, "paths": [home], "created": dt.datetime.now().isoformat(timespec="seconds")}
    try:
        fd = os.open(key_path(), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(key + "\n")
        run_restic(cfg, ["init"], capture=True)
        save_config(cfg)
    except BaseException:
        # Any failure or Ctrl+C: never leave a key behind for a backup that was not recorded.
        try:
            os.unlink(key_path())
        except OSError:
            pass
        raise
    print("Backups are set up.")
    print(f"Backup folder: {dest}")
    print("Recovery key (write this down or keep a copy somewhere other than this computer):")
    print(f"  {key}")
    print("If this computer is lost and you do not have this key, the backup cannot be opened.")
    print("Run 'nizho-backup now' to make the first backup.")


def cmd_now(a):
    cfg = need_config()
    if not drive_connected(cfg):
        if a.quiet:
            return
        raise Fail("The backup drive is not connected: " + cfg["repo"])
    args = ["backup", "--tag", "nizho", "--exclude-caches", "--one-file-system"]
    for e in EXCLUDES:
        args += ["--exclude", e]
    try:
        p = restic_process(cfg, args + cfg["paths"], capture=True, ok=(0, 3))
    except Fail:
        if a.quiet and not drive_connected(cfg):
            return  # the drive was unplugged during the run: same as "not connected", nothing marked
        raise
    # restic code 3 means the backup was saved but some files could not be read (a file that
    # changed or vanished while it was read). The saved backup is real, so it counts.
    partial = p.returncode == 3
    cfg["last_ok"] = dt.datetime.now().isoformat(timespec="seconds")
    save_config(cfg)
    if partial:
        print("nizho-backup: the backup was saved, but some files could not be read and are not in it.", file=sys.stderr)
    if not a.quiet:
        lines = (p.stdout or "").strip().splitlines()
        print(lines[-1] if lines else "Backup finished.")


def snapshots(cfg):
    try:
        return json.loads(run_restic(cfg, ["snapshots", "--json"], capture=True) or "[]")
    except ValueError:
        raise Fail("restic gave an answer that could not be understood.")


def ago(ts):
    try:
        d = dt.datetime.now() - dt.datetime.fromisoformat(ts)
    except (TypeError, ValueError):
        return "unknown"
    s = int(d.total_seconds())
    if s < -300:
        return "unknown"  # the clock was set back; do not claim a recent backup
    if s < 90:
        return "just now"
    if s < 5400:
        return f"{s // 60} minutes ago"
    if s < 172800:
        return f"{s // 3600} hours ago"
    return f"{s // 86400} days ago"


def cmd_status(a):
    cfg = load_config()
    if not cfg:
        info = {"configured": False, "text": "Backups are not set up."}
    else:
        connected = drive_connected(cfg)
        info = {"configured": True, "repo": cfg["repo"], "connected": connected, "last_ok": cfg.get("last_ok")}
        if cfg.get("last_ok"):
            info["text"] = "Last backup: " + ago(cfg["last_ok"])
        else:
            info["text"] = "No backup has finished yet"
        if not connected:
            info["text"] += ". The backup drive is not connected."
        else:
            info["text"] += "."
    if a.json:
        print(json.dumps(info))
    else:
        print(info["text"])


def cmd_list(a):
    cfg = need_config()
    if not drive_connected(cfg):
        raise Fail("The backup drive is not connected: " + cfg["repo"])
    snaps = snapshots(cfg)
    if not snaps:
        print("There are no backups yet.")
    for s in sorted(snaps, key=lambda x: x["time"]):
        print(f'{s["short_id"]}  {s["time"][:19].replace("T", " ")}')


def pick_snapshot(snaps, wanted):
    """The newest backup, or the one whose id starts with WANTED."""
    ordered = sorted(snaps, key=lambda x: x["time"])
    if not wanted or wanted == "latest":
        return ordered[-1]
    hits = [s for s in ordered if s["id"].startswith(wanted) or s.get("short_id") == wanted]
    if len(hits) != 1:
        raise Fail("That backup was not found. Run: nizho-backup list")
    return hits[0]


def snapshot_node_dir(snap, home):
    """restic stores the home folder under the name it had when backed up, which on Nizho is the real
    /var/home/NAME even if you reach it as /home/NAME. Return the path the home folder has inside this backup."""
    paths = [os.path.normpath(p) for p in snap.get("paths") or []]
    real = os.path.realpath(home)
    candidates = [real, os.path.normpath(home)]
    mine = next((p for p in paths if p in candidates), None) or next((p for p in paths if os.path.realpath(p) == real), None)
    if mine is None:
        return None
    return mine


def clean_rel(path):
    """PATH as given by the user, checked and turned into a relative path ('.' for the home folder)."""
    p = path or "."
    if p.startswith("/") or "\0" in p or ".." in p.split("/"):
        raise Fail("Give PATH relative to your home folder, for example Documents, and without '..'.")
    return os.path.normpath(p)


def list_entries(cfg, snap, rel):
    """The entries directly inside REL in SNAP, as dicts, folders first. Raises Fail with plain words."""
    base = snapshot_node_dir(snap, os.path.expanduser("~"))
    if base is None:
        raise Fail("This backup does not hold your home folder.")
    target = base if rel == "." else base + "/" + rel
    out = run_restic(cfg, ["ls", "--json", snap["id"], "--", target], capture=True)
    self_node, entries = None, []
    for line in out.splitlines():
        try:
            n = json.loads(line)
        except ValueError:
            continue
        if n.get("struct_type") != "node":
            continue
        if n.get("path") == target:
            self_node = n
        elif os.path.dirname(n.get("path", "")) == target:
            entries.append({"name": n["name"], "type": "dir" if n.get("type") == "dir" else "file",
                            "size": n.get("size", 0) if n.get("type") != "dir" else 0, "mtime": n.get("mtime", "")})
    if self_node is None:
        raise Fail(f"{rel} was not found in that backup.")
    if self_node.get("type") != "dir":
        raise Fail(f"{rel} is a file, not a folder.")
    entries.sort(key=lambda e: (e["type"] != "dir", e["name"].casefold(), e["name"]))
    return entries


def human_size(n):
    for unit in ("bytes", "KB", "MB", "GB"):
        if n < 1000 or unit == "GB":
            return f"{n} bytes" if unit == "bytes" else f"{n:.1f} {unit}"
        n /= 1000


def cmd_snapshots(a):
    cfg = need_config()
    if not drive_connected(cfg):
        raise Fail("The backup drive is not connected: " + cfg["repo"])
    snaps = sorted(snapshots(cfg), key=lambda x: x["time"], reverse=True)
    if a.json:
        print(json.dumps([{"id": s["id"], "time": s["time"]} for s in snaps]))
    elif not snaps:
        print("There are no backups yet.")
    else:
        for s in snaps:
            print(f'{s["short_id"]}  {s["time"][:19].replace("T", " ")}')


def cmd_ls(a):
    cfg = need_config()
    if not drive_connected(cfg):
        raise Fail("The backup drive is not connected: " + cfg["repo"])
    rel = clean_rel(a.path)
    snaps = snapshots(cfg)
    if not snaps:
        print("[]" if a.json else "There are no backups yet.")
        return
    entries = list_entries(cfg, pick_snapshot(snaps, a.snapshot), rel)
    if a.json:
        print(json.dumps(entries))
    elif not entries:
        print("This folder is empty.")
    else:
        for e in entries:
            size = "" if e["type"] == "dir" else human_size(e["size"])
            print(f'{e["type"]:<5} {size:>10}  {e["mtime"][:16].replace("T", " ")}  {e["name"]}' + ("/" if e["type"] == "dir" else ""))


def cmd_restore(a):
    cfg = need_config()
    if not drive_connected(cfg):
        raise Fail("The backup drive is not connected: " + cfg["repo"])
    target = os.path.abspath(os.path.expanduser(a.to))
    home = os.path.expanduser("~")
    rels = []
    for path in a.paths:
        if os.path.abspath(path) == path:
            raise Fail("Give PATH relative to your home folder, for example Documents/report.odt.")
        sub = os.path.normpath(os.path.join(home, path))
        if not (sub == home or sub.startswith(home + os.sep)):
            raise Fail("PATH must stay inside your home folder.")
        rel = os.path.relpath(sub, home)
        if rel == ".":
            raise Fail("Choose a file or folder inside your home folder, not the whole home folder.")
        if rel not in rels:
            rels.append(rel)
    # One item inside another would be restored twice; ask for just one of them.
    for r in rels:
        for o in rels:
            if r != o and r.startswith(o + os.sep):
                raise Fail(f"{r} is inside {o}. Choose only one of them.")
    if a.snapshot and not (a.snapshot == "latest" or re.fullmatch(r"[0-9a-fA-F]{4,64}", a.snapshot)):
        raise Fail("The snapshot must be an id from 'nizho-backup list', or left out for the latest.")
    if os.path.exists(target) and not os.path.isdir(target):
        raise Fail("The restore folder is a file, not a folder. Choose an empty folder.")
    if os.path.exists(target) and os.listdir(target):
        raise Fail("The restore folder is not empty. Restoring never overwrites your files; choose an empty folder.")
    # Ask restic for each item under the home folder's name INSIDE this backup, as browsing does: on Nizho
    # /home is a link to /var/home, so a backup made as /home/NAME and a session whose HOME is
    # /var/home/NAME (or the other way round) name the same file differently (seen in the VM, 2026-11-13).
    snaps = snapshots(cfg)
    if not snaps:
        raise Fail("There are no backups yet.")
    snap = pick_snapshot(snaps, a.snapshot)
    base = snapshot_node_dir(snap, home)
    if base is None:
        raise Fail("This backup does not hold your home folder.")
    os.makedirs(target, exist_ok=True)
    staging = tempfile.mkdtemp(prefix=".nizho-restore-", dir=target)
    done = []
    try:
        # Every item in one restic run, so several items land in the one empty folder chosen.
        includes = []
        for rel in rels:
            includes += ["--include", glob_escape(base + "/" + rel)]
        run_restic(cfg, ["restore", snap["id"], "--target", staging] + includes, capture=True)
        # All or nothing: if one is missing, nothing is moved and the folder stays empty.
        found = {}
        for rel in rels:
            f = find_restored(staging, rel)
            if not f:
                raise Fail(f"{rel} was not found in that backup.")
            found[rel] = f
        for rel in rels:
            dest = os.path.join(target, rel)
            os.makedirs(os.path.dirname(dest), exist_ok=True)
            shutil.move(found[rel], dest)
            done.append(dest)
    finally:
        shutil.rmtree(staging, ignore_errors=True)
    for dest in done:
        print(f"Restored to {dest}")
    print("Your existing files were not touched. Copy back what you need.")


def glob_escape(path):
    """restic reads --include as a pattern, so a name such as 'trip [2020]' must be escaped."""
    return re.sub(r"([\\*?\[\]])", r"\\\1", path)


def find_restored(staging, rel):
    """restic keeps the full original path (on Nizho the home folder is really /var/home/NAME),
    so look for the item by its path inside the home folder and ignore the prefix."""
    suffix = os.sep + rel
    for root, dirs, files in os.walk(staging):
        for n in dirs + files:
            p = os.path.join(root, n)
            if p.endswith(suffix):
                return p
    return None


def cmd_tidy(a):
    cfg = need_config()
    if not drive_connected(cfg):
        raise Fail("The backup drive is not connected: " + cfg["repo"])
    run_restic(cfg, ["forget", "--tag", "nizho", "--prune"] + KEEP, capture=True)
    print("Old backups removed. Kept 7 daily, 4 weekly and 6 monthly.")


def main(argv=None):
    p = argparse.ArgumentParser(prog="nizho-backup", description="Encrypted backups of your files.")
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("setup"); s.add_argument("--to", required=True); s.add_argument("--allow-home", action="store_true"); s.set_defaults(f=cmd_setup)
    n = sub.add_parser("now"); n.add_argument("--quiet", action="store_true"); n.set_defaults(f=cmd_now)
    t = sub.add_parser("status"); t.add_argument("--json", action="store_true"); t.set_defaults(f=cmd_status)
    sub.add_parser("list").set_defaults(f=cmd_list)
    r = sub.add_parser("restore"); r.add_argument("paths", nargs="+", metavar="PATH"); r.add_argument("--to", required=True); r.add_argument("--snapshot"); r.set_defaults(f=cmd_restore)
    q = sub.add_parser("snapshots"); q.add_argument("--json", action="store_true"); q.set_defaults(f=cmd_snapshots)
    l = sub.add_parser("ls"); l.add_argument("path", nargs="?"); l.add_argument("--snapshot"); l.add_argument("--json", action="store_true"); l.set_defaults(f=cmd_ls)
    sub.add_parser("tidy").set_defaults(f=cmd_tidy)
    a = p.parse_args(argv)
    try:
        if a.cmd in ("setup", "now", "tidy", "restore"):
            with exclusive():
                a.f(a)
        else:
            a.f(a)
    except Busy as e:
        if a.cmd == "now" and a.quiet:
            return 0
        print(f"nizho-backup: {e}", file=sys.stderr)
        return 1
    except Fail as e:
        print(f"nizho-backup: {e}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("nizho-backup: stopped.", file=sys.stderr)
        return 130
    except OSError as e:
        print(f"nizho-backup: {e.strerror or e}" + (f": {e.filename}" if e.filename else ""), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
