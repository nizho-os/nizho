#!/bin/bash
# Shell snippets passed to runuser expand their positional arguments in the child.
# shellcheck disable=SC2016
# nizho-oobe-apply — privileged tail of the graphical first-run wizard.
#
# Runs as root via a tight NOPASSWD sudo rule (see Containerfile), invoked by
# nizho-oobe which itself runs UNPRIVILEGED inside the nizhosetup login session.
# This is the only privileged step: create the account the user just entered,
# set autologin, switch to the graphical target, and mark first-boot done.
#
#   usage: nizho-oobe-apply <username> <autologin:0|1> [light|dark
#                            [<computer-name> [<tools> <commit-name> <commit-email>
#                            [<time-zone> [<accent> [<language> [<keyboard> [<phone>]]]]]]]]
#          (password on stdin; look defaults to dark, the image default;
#           the computer name defaults to nizho, the privacy default;
#           the time zone is a tz database name such as Europe/Berlin, and when
#           it is left out the image's own zone stays; callers that pick a time
#           zone but no version control pass three empty strings before it;
#           the accent is green or blue, green when left out, and a caller that
#           picks one but no time zone passes an empty string for the zone;
#           the last argument, phone, is yes or no: yes opens the firewall rule for
#           KDE Connect and starts it at login for the new account. When it is left
#           out or empty the answer is no, and nothing about phones is changed)
#
# tools is the optional version control from setup's Advanced options: a comma
# list of vara and git, each set up with the name and email for commits.
#
# Interrupted setup. The account is created early and /var/lib/nizho-firstboot-done
# is written last. If this script stops in between (power loss, a failed step),
# the account exists and setup is not complete. /var/lib/nizho-oobe-partial holds
# the username this script is creating. It is written, mode 0600, before the
# account is made, and removed when setup completes. A later run with the same
# username continues from the start with that account: it sets the password
# again and repeats every step. An account that this file does not name is
# never taken over. A continued run puts back the phone link, computer name,
# login theme and login accent defaults when it leaves them out. It does not
# undo a time zone, language, keyboard or version control identity that the
# interrupted run set and this run leaves out.
set -euo pipefail

if [ "$#" -lt 2 ] || [ "$#" -gt 12 ] || [ "$#" -eq 5 ] || [ "$#" -eq 6 ]; then
    echo "nizho-oobe-apply: expected username, autologin flag, optional look, computer name, version control, time zone, accent, language, keyboard and phone link" >&2
    exit 2
fi
user="$1"
autologin="$2"
look="${3:-dark}"
host="${4:-nizho}"
tools="${5:-}"
commit_name="${6:-}"
commit_email="${7:-}"
zone="${8:-}"
accent="${9:-green}"
locale="${10:-}"
keyboard="${11:-}"
phone="${12:-no}"
[ -n "$phone" ] || phone=no

# Serialize account creation, including retries from the graphical and TUI paths.
exec 9>/run/nizho-oobe.lock
flock -n 9 || { echo "nizho-oobe-apply: setup is already running" >&2; exit 1; }
if [ -e /var/lib/nizho-firstboot-done ]; then
    echo "nizho-oobe-apply: setup is already complete" >&2
    exit 1
fi

# Validate the username here too — never trust the caller alone.
if [[ ! "$user" =~ ^[a-z][a-z0-9_-]{0,30}$ ]]; then
    echo "nizho-oobe-apply: invalid username" >&2
    exit 2
fi

if [[ "$autologin" != "0" && "$autologin" != "1" ]]; then
    echo "nizho-oobe-apply: invalid autologin flag" >&2
    exit 2
fi

if [[ "$look" != "light" && "$look" != "dark" ]]; then
    echo "nizho-oobe-apply: invalid look" >&2
    exit 2
fi

# A computer name is letters, digits and hyphens, starting with a letter (RFC 1123 label).
if [[ ! "$host" =~ ^[a-z]([a-z0-9-]{0,28}[a-z0-9])?$ ]]; then
    echo "nizho-oobe-apply: invalid computer name" >&2
    exit 2
fi

if [[ "$accent" != "green" && "$accent" != "blue" ]]; then
    echo "nizho-oobe-apply: invalid accent" >&2
    exit 2
fi

# A time zone is a tz database name: up to three parts of letters, digits, _, + and -
# (America/Argentina/Buenos_Aires, Etc/GMT+5). No dots, so no path tricks, and the
# name must be a real zone file.
if [ -n "$zone" ]; then
    if [[ ! "$zone" =~ ^[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+){0,2}$ ]] || [ ! -f "/usr/share/zoneinfo/$zone" ]; then
        echo "nizho-oobe-apply: invalid time zone" >&2
        exit 2
    fi
fi

# A language is a glibc locale such as ta_IN.UTF-8: lower-case language, upper-case country, UTF-8 only.
if [ -n "$locale" ] && [[ ! "$locale" =~ ^[a-z]{2,3}_[A-Z]{2}\.UTF-8$ ]]; then
    echo "nizho-oobe-apply: invalid language" >&2
    exit 2
fi

# A keyboard layout must be one the system's own list names (the "! layout" section).
if [ -n "$keyboard" ]; then
    if [[ ! "$keyboard" =~ ^[a-z]{2,8}$ ]] ||
       ! awk -v k="$keyboard" '/^! /{on=($2=="layout");next} on&&$1==k{f=1} END{exit !f}' /usr/share/X11/xkb/rules/evdev.lst; then
        echo "nizho-oobe-apply: invalid keyboard layout" >&2
        exit 2
    fi
fi

# Linking a phone is off unless the answer is exactly yes.
if [[ "$phone" != "yes" && "$phone" != "no" ]]; then
    echo "nizho-oobe-apply: invalid phone link answer" >&2
    exit 2
fi

if [ -n "$tools" ]; then
    for tool in ${tools//,/ }; do
        if [[ "$tool" != "vara" && "$tool" != "git" ]]; then
            echo "nizho-oobe-apply: invalid version control tool" >&2
            exit 2
        fi
    done
    if [ -z "$commit_name" ] || [ "${#commit_name}" -gt 100 ] || [[ "$commit_name" == *[[:cntrl:]]* ]]; then
        echo "nizho-oobe-apply: invalid name for commits" >&2
        exit 2
    fi
    if [ "${#commit_email}" -gt 254 ] || [[ ! "$commit_email" =~ ^[^[:space:][:cntrl:]@]+@[^[:space:][:cntrl:]@]+$ ]]; then
        echo "nizho-oobe-apply: invalid email for commits" >&2
        exit 2
    fi
fi

# The username an interrupted run was creating, if any. The file must be a plain
# file owned by this script's user (root) holding one valid username. Anything
# else stops setup: a damaged file is never guessed at.
partial=/var/lib/nizho-oobe-partial
partial_user=
if [ -e "$partial" ] || [ -L "$partial" ]; then
    if [ -L "$partial" ] || [ ! -f "$partial" ] || [ ! -O "$partial" ]; then
        echo "nizho-oobe-apply: $partial is not a file this setup wrote; setup cannot continue" >&2
        exit 1
    fi
    IFS= read -r partial_user < "$partial" || true
    if [[ ! "$partial_user" =~ ^[a-z][a-z0-9_-]{0,30}$ ]] || [ "$(wc -l < "$partial")" -ne 1 ]; then
        echo "nizho-oobe-apply: $partial does not hold one valid username; setup cannot continue" >&2
        exit 1
    fi
fi

# Never reset an existing account, including root or the setup user. The one
# exception is the account an interrupted run of this script created.
resume=0
if id -u "$user" >/dev/null 2>&1; then
    if [ "$partial_user" != "$user" ]; then
        echo "nizho-oobe-apply: account already exists; choose a new username" >&2
        exit 2
    fi
    resume=1
elif [ -n "$partial_user" ] && [ "$partial_user" != "$user" ] && id -u "$partial_user" >/dev/null 2>&1; then
    # Another account is half set up. Making a second one would leave it behind.
    echo "nizho-oobe-apply: setup stopped earlier while creating the account '$partial_user'; use that username to continue" >&2
    exit 2
fi

# Password arrives on stdin so it never appears in argv / process list.
IFS= read -r pass || { echo "nizho-oobe-apply: password required" >&2; exit 2; }
if [ "${#pass}" -lt 8 ]; then
    echo "nizho-oobe-apply: password must be at least 8 characters" >&2
    exit 2
fi
trap 'unset pass' EXIT
if [ "$resume" = 0 ]; then
    # Name the account on disk before it exists, so a run that stops after
    # useradd can be told apart from an unrelated account of the same name.
    # A file left by a run that never made its account is replaced here.
    rm -f "$partial.new"
    ( umask 077 && printf '%s\n' "$user" > "$partial.new" )
    mv -f "$partial.new" "$partial"
    sync -f "$partial"
    if ! useradd -m -G wheel -s /bin/bash "$user"; then
        # No account was made, so there is nothing to continue.
        id -u "$user" >/dev/null 2>&1 || rm -f "$partial"
        echo "nizho-oobe-apply: could not create the account" >&2
        exit 1
    fi
else
    echo "nizho-oobe-apply: continuing the interrupted setup of the account '$user'" >&2
fi
printf '%s:%s\n' "$user" "$pass" | chpasswd
unset pass

# The new account can already log in. Never follow its .config links as root.
# Apply this user-owned preference with that account's permissions instead.
# Besides recording the look, pre-write its colours, Plasma style, icons and
# wallpaper so the very first desktop frame already matches (no dark-to-light
# or KDE-to-Nizho flash while the first-login script catches up).
runuser -u "$user" -- bash -c '
    set -eu
    umask 077
    home=$1 look=$2 accent=$3
    mkdir -p -- "$home/.config"
    printf "%s\n" "$look" > "$home/.config/nizho-look"
    printf "%s\n" "$accent" > "$home/.config/nizho-accent"
    command -v kwriteconfig6 >/dev/null || exit 0
    if [ "$look" = light ]; then
        scheme=NizhoLight style=nizho-light icons=Nizho-Light laf=org.nizho.light.desktop wall=Nizho-Light
    else
        scheme=Nizho style=nizho-dark icons=Nizho laf=org.nizho.dark.desktop wall=Nizho-Dark
    fi
    # The accent: the blue schemes and wallpapers have Blue on the end of their names.
    accent_rgb="77,180,145"
    if [ "$accent" = blue ]; then scheme=${scheme}Blue wall=${wall}-Blue accent_rgb="79,134,255"; fi
    kg=$home/.config/kdeglobals
    colors=/usr/share/color-schemes/$scheme.colors
    if [ -r "$colors" ]; then
        groups=()
        while IFS= read -r line; do
            case "$line" in
                "["*"]") inner=${line#[}; inner=${inner%]}; IFS="]" read -ra parts <<< "${inner//][/]}"; groups=()
                         for g in "${parts[@]}"; do groups+=(--group "$g"); done ;;
                *=*) [ ${#groups[@]} -gt 0 ] && kwriteconfig6 --file "$kg" "${groups[@]}" --key "${line%%=*}" "${line#*=}" ;;
            esac
        done < "$colors"
    fi
    kwriteconfig6 --file "$kg" --group General --key ColorScheme "$scheme"
    kwriteconfig6 --file "$kg" --group General --key AccentColor "$accent_rgb"
    kwriteconfig6 --file "$kg" --group Icons --key Theme "$icons"
    kwriteconfig6 --file "$kg" --group KDE --key LookAndFeelPackage "$laf"
    kwriteconfig6 --file "$home/.config/plasmarc" --group Theme --key name "$style"
    kwriteconfig6 --file "$home/.config/plasmarc" --group Wallpapers --key defaultWallpaperTheme "$wall"
' nizho-setup-look "/home/$user" "$look" "$accent"

# Optional version control. runuser keeps root's HOME and working directory, so
# give the tools the new account's own (Git looks for a repository in the
# working directory even for --global settings and fails in root's). Each tool
# writes only that account's settings. A failure here is reported but does not
# stop setup: the account matters more.
for tool in ${tools//,/ }; do
    as_user=(runuser -u "$user" -- env --chdir="/home/$user" HOME="/home/$user" XDG_CONFIG_HOME="/home/$user/.config")
    case "$tool" in
        vara) "${as_user[@]}" vara identity set --default --name "$commit_name" --email "$commit_email" >/dev/null ||
                  echo "nizho-oobe-apply: warning: could not set the VARA identity" >&2 ;;
        git)  { "${as_user[@]}" git config --global user.name "$commit_name" &&
                "${as_user[@]}" git config --global user.email "$commit_email"; } ||
                  echo "nizho-oobe-apply: warning: could not set the Git identity" >&2 ;;
    esac
done

# The time zone the user chose. A failure is reported but does not stop setup: the
# account matters more, and the zone can be changed later in Settings.
if [ -n "$zone" ]; then
    timedatectl set-timezone "$zone" ||
        ln -sfn "/usr/share/zoneinfo/$zone" /etc/localtime ||
        echo "nizho-oobe-apply: warning: could not set the time zone" >&2
fi

# The language and keyboard the user chose. Failures are reported but do not stop setup:
# both can be changed later in Settings. The keyboard is set for the login screen
# (localectl) and for the user's own desktop session (kxkbrc).
if [ -n "$locale" ]; then
    localectl set-locale "LANG=$locale" || echo "nizho-oobe-apply: warning: could not set the language" >&2
fi
if [ -n "$keyboard" ]; then
    localectl set-x11-keymap "$keyboard" || echo "nizho-oobe-apply: warning: could not set the keyboard layout" >&2
    runuser -u "$user" -- bash -c '
        f=$1/.config/kxkbrc
        kwriteconfig6 --file "$f" --group Layout --key Use true &&
        kwriteconfig6 --file "$f" --group Layout --key LayoutList "$2"
    ' nizho-setup-keyboard "/home/$user" "$keyboard" ||
        echo "nizho-oobe-apply: warning: could not set the keyboard for the desktop" >&2
fi

# Phone link, only when the user said yes. The helper opens the firewall rule (this script
# already runs as root, so no password prompt). KDE Connect then starts at login for the new
# account, the same autostart entry Settings writes. If the rule could not be opened the
# autostart is not written, so nothing runs without its firewall rule. A failure is reported
# but does not stop setup: the user can switch it on later in Settings, Internet.
if [ "$phone" = "yes" ]; then
    if /usr/libexec/nizho-phone-link on; then
        runuser -u "$user" -- bash -c '
            set -eu
            umask 077
            dir=$1/.config/autostart
            mkdir -p -- "$dir"
            printf "%s\n" "[Desktop Entry]" "Type=Application" "Name=KDE Connect" "Exec=/usr/bin/kdeconnectd" \
                "StartupNotify=false" "X-KDE-autostart-phase=1" "NoDisplay=true" "Hidden=false" \
                > "$dir/org.kde.kdeconnect.daemon.desktop"
        ' nizho-setup-phone "/home/$user" ||
            echo "nizho-oobe-apply: warning: could not start KDE Connect at login" >&2
    else
        echo "nizho-oobe-apply: warning: could not link your phone; turn it on later in Settings, Internet" >&2
    fi
elif [ "$resume" = 1 ]; then
    # The interrupted run may have said yes. This run says no, so close the rule
    # and remove the autostart entry that run may have written.
    /usr/libexec/nizho-phone-link off ||
        echo "nizho-oobe-apply: warning: could not close the phone link rule; check Settings, Internet" >&2
    runuser -u "$user" -- rm -f -- "/home/$user/.config/autostart/org.kde.kdeconnect.daemon.desktop" ||
        echo "nizho-oobe-apply: warning: could not remove the KDE Connect autostart entry" >&2
fi

# A computer name other than the default goes into nizhod's settings, so nizhod sets it
# now and puts it back if anything changes it. A continued setup writes the name
# even when it is the default, in case the interrupted run saved another one.
if [ "$host" != "nizho" ] || [ "$resume" = 1 ]; then
    sed -i "/^\[hostname\]/,/^\[/ s/^name = .*/name = \"$host\"/" /etc/nizhod/nizhod.toml
    grep -q "^name = \"$host\"" /etc/nizhod/nizhod.toml ||
        echo "nizho-oobe-apply: warning: could not save the computer name" >&2
fi

mkdir -p /etc/sddm.conf.d
# Login screen follows the chosen look and accent. Each combination is its own copy of the theme,
# built into the image (nizho, nizho-light, nizho-blue, nizho-light-blue; see Containerfile),
# because the login screen cannot read the accent from a user's files.
theme=nizho
[ "$look" = "light" ] && theme=nizho-light
[ "$accent" = "blue" ] && theme="$theme-blue"
# A continued setup writes the default theme too, in case the interrupted run chose another.
if [ "$theme" != "nizho" ] || [ "$resume" = 1 ]; then
    printf '[Theme]\nCurrent=%s\n' "$theme" > /etc/sddm.conf.d/30-nizho-theme.conf
fi
# The login screen takes its accent from the sddm account's colour scheme (see the Containerfile),
# so a blue choice gives it the blue scheme. A failure here does not stop setup.
if [ "$accent" = "blue" ]; then
    scheme=/usr/share/color-schemes/NizhoBlue.colors
    { [ -r "$scheme" ] && mkdir -p /var/lib/sddm/.config &&
        cp "$scheme" /var/lib/sddm/.config/kdeglobals &&
        chown sddm:sddm /var/lib/sddm/.config /var/lib/sddm/.config/kdeglobals &&
        chmod 0644 /var/lib/sddm/.config/kdeglobals; } ||
        echo "nizho-oobe-apply: warning: could not give the login screen the blue accent" >&2
elif [ "$resume" = 1 ] && [ -e /var/lib/sddm/.config/kdeglobals ]; then
    # The interrupted run may have chosen blue. Put the image's green scheme back.
    scheme=/usr/share/color-schemes/Nizho.colors
    { [ -r "$scheme" ] && cp "$scheme" /var/lib/sddm/.config/kdeglobals &&
        chown sddm:sddm /var/lib/sddm/.config/kdeglobals &&
        chmod 0644 /var/lib/sddm/.config/kdeglobals; } ||
        echo "nizho-oobe-apply: warning: could not give the login screen the green accent back" >&2
fi
if [ "$autologin" = "1" ]; then
    printf '[Autologin]\nUser=%s\nSession=plasma.desktop\n' "$user" \
        > /etc/sddm.conf.d/20-autologin.conf
else
    rm -f /etc/sddm.conf.d/20-autologin.conf
fi

# Seed SDDM's last-user so the greeter greets the new account.
mkdir -p /var/lib/sddm
printf '[Last]\nUser=%s\nSession=/usr/share/wayland-sessions/plasma.desktop\n' "$user" \
    > /var/lib/sddm/state.conf
chown sddm:sddm /var/lib/sddm/state.conf

# Hand the machine to the graphical target and stop the first-run flow for good.
# Order matters. Every step above can fail and leave setup resumable: the done
# flag is absent, the partial file names the account and the setup account
# keeps the sudo rule it needs to run this script again. The rule is removed
# only here, after the done flag is written.
systemctl set-default graphical.target
touch /var/lib/nizho-firstboot-done
rm -f "$partial"
rm -f /etc/sudoers.d/95-nizho-oobe
