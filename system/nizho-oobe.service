# NOT INSTALLED. The Containerfile does not copy this unit into the image, and
# nothing below describes how setup runs today. The wizard does not run as
# root: the unprivileged nizhosetup account auto-logs in on tty1, logind gives
# its session the seat, its login shell starts cage with nizho-oobe, and only
# /usr/libexec/nizho-oobe-apply runs as root, through the sudo rule in
# /etc/sudoers.d/95-nizho-oobe (see "Graphical first-run wizard" in the
# Containerfile). Kept for reference only.
[Unit]
Description=Nizho first-run setup (graphical OOBE)
DefaultDependencies=no
After=basic.target systemd-user-sessions.service plymouth-quit-wait.service
Before=getty@tty1.service nizho-firstboot.service
Conflicts=getty@tty1.service
ConditionPathExists=!/var/lib/nizho-firstboot-done

[Service]
# Old design, not in use (see the top of this file): run the graphical wizard
# inside cage on tty1 as root, before any user exists. On success it writes /var/lib/nizho-firstboot-done,
# so the TUI fallback (nizho-firstboot.service, ordered after this) skips. If
# cage can't start (no DRM/GPU), this exits without the flag and the TUI runs.
Type=simple
ExecStart=/usr/bin/cage -- /usr/bin/nizho-oobe
Restart=no
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
RuntimeDirectory=nizho-oobe
Environment=XDG_RUNTIME_DIR=/run/nizho-oobe
Environment=LIBSEAT_BACKEND=builtin
Environment=XDG_SEAT=seat0
Environment=GTK_THEME=Adwaita:dark
Environment=GDK_BACKEND=wayland

[Install]
WantedBy=multi-user.target
